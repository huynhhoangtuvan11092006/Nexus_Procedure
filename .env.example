# ==========================================
# NexusProcure AI - Environment Variables
# ==========================================

# Choose LLM Provider: 'groq' or 'gemini'
LLM_PROVIDER=groq

# 1. Groq API Configuration (Recommended for high speed)
GROQ_API_KEY=your_groq_api_key_here
GROQ_STRATEGIC_MODEL=qwen/qwen-2.5-32b
GROQ_FAST_MODEL=llama-3.1-8b-instant

# 2. Google Gemini API Configuration (Alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Storage & Database Paths
SQLITE_DB_PATH=app/data/procurement.db
CHROMA_PERSIST_DIR=app/data/chroma_db
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Negotiation Settings
MAX_NEGOTIATION_ROUNDS=4
DEFAULT_CONCESSION_RATE=0.03
